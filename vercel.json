{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "akram-marref-site.vercel.app"
        }
      ],
      "destination": "https://akram-marref.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/works/works/:path*",
      "destination": "/works/:path*",
      "permanent": true
    },
    {
      "source": "/projects/:match*",
      "destination": "/works/:match*",
      "permanent": true
    },
    {
      "source": "/works/perfumes-media-posts",
      "destination": "/works/viloria-perfumes",
      "permanent": true
    },
    {
      "source": "/works/zr-express",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/bulakasfalo-restaurant-logo-branding-design",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/zr-express-re-branding",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/lamaat-fun-logo-brand-identity-design",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/precious-kitchen-logo-branding-design",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/soundcloud-website-ui-ux-re-design",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/carossa-startup-mobile-app-ui-ux-design",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/vectorial-studio",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/formura-labs-full-branding",
      "destination": "/works/al-rayyan-castle",
      "permanent": true
    },
    {
      "source": "/works/timeplus",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/logofolio",
      "destination": "/works",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
